{
	"appId": "com.snacklaps.game",
	"appName": "Snack Laps",
	"webDir": "www",
	"server": {
		"androidScheme": "https"
	},
	"ios": {
		"contentInset": "never",
		"backgroundColor": "#3fae55",
		"preferredContentMode": "mobile",
		"scheme": "Snack Laps"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1200,
			"launchAutoHide": true,
			"backgroundColor": "#3fae55",
			"showSpinner": false,
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"StatusBar": {
			"style": "LIGHT",
			"backgroundColor": "#00000000"
		}
	},
	"packageClassList": [
		"AdMobPlugin",
		"AppPlugin",
		"HapticsPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin",
		"CapacitorGameConnectPlugin"
	]
}
